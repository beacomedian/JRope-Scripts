    <reapack name="jrope_Play Toggle Double Speed.lua" type="script" desc="Play Toggle double Speed and Reset Playrate on Stop">
      <metadata>
        <description><![CDATA[{\rtf1\ansi\deff0{\fonttbl{\f0 \fswiss Helvetica;}{\f1 \fmodern Courier;}}
{\colortbl;\red255\green0\blue0;\red0\green0\blue255;}
\widowctrl\hyphauto

{\pard \ql \f0 \sa180 \li0 \fi0 Play at double Speed or Toggle to Normal Speed if already playing, and Reset Playrate on Stop. Chose "New Instance" when retriggering.\par}
}
